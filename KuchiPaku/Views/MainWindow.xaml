<Window
  x:Class="KuchiPaku.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:epoxy="https://github.com/kekyo/Epoxy"
  xmlns:ui="http://schemas.modernwpf.com/2019"
  xmlns:fw="clr-namespace:SourceChord.FluentWPF;assembly=FluentWPF"
  xmlns:controls="clr-namespace:Enterwell.Clients.Wpf.Notifications.Controls;assembly=Enterwell.Clients.Wpf.Notifications"
  xmlns:viewmodels="clr-namespace:KuchiPaku.ViewModels"
  xmlns:res="clr-namespace:KuchiPaku.Resources"
  mc:Ignorable="d"
  ui:WindowHelper.UseModernWindowStyle="True"
  Height="500" Width="800"
  fw:AcrylicWindow.Enabled="True"
  fw:PointerTracker.Enabled="True"
  Title="{Binding WindowTitle}"
  ResizeMode="CanResizeWithGrip">

  <Window.DataContext>
    <viewmodels:MainWindowViewModel />
  </Window.DataContext>

  <Window.Resources>
    <!--
    <Style TargetType="GroupBox">
      <Setter Property="Padding" Value="10,5" />
    </Style>
    -->
    <BooleanToVisibilityConverter x:Key="BoolToVisible"/>
  </Window.Resources>

  <!--
  <epoxy:EventBinder.Events>
    <epoxy:Event EventName="Loaded" Command="{Binding Ready}" />
  </epoxy:EventBinder.Events>
  -->

  <Grid>
    <Border Grid.Column="1" Panel.ZIndex="2">
        <controls:NotificationMessageContainer Manager="{Binding Manager}" />
    </Border>
    <ui:NavigationView
      x:Name="NavView"
      IsBackButtonVisible="Collapsed"
      IsBackEnabled="False"
      IsPaneOpen="True"
      Background="Transparent"
    >
      <!-- LEFT NAVIGATION -->
      <!--
      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Icon="OpenFile" Content="Sample Item 1">
          <epoxy:EventBinder.Events>
            <epoxy:Event EventName="PointerPressed" Command="{Binding OpenYmmp}" />
          </epoxy:EventBinder.Events>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Icon="ContactInfo" Content="Sample Item 2" />
        <ui:NavigationViewItem Icon="List" Content="Sample Item 3" />
        <ui:NavigationViewItem Icon="Save" Content="Sample Item 4" />
      </ui:NavigationView.MenuItems>
      -->

      <ScrollViewer
        Background="{DynamicResource SystemBaseLowColorBrush}">
        <ui:SimpleStackPanel
          Width="Auto"
          Margin="5,0"
          >
          <ui:CommandBar
              DefaultLabelPosition="Bottom"
              Background="{DynamicResource SystemBaseLowColorBrush}"
            >
            <ui:AppBarButton
              x:Name="OpenYmmp"
              Label="{x:Static res:Resources.OpenYmmpLabel}"
              Icon="OpenFile"
              LabelPosition="Default"
              Command="{Binding OpenYmmp}"
            />

            <ui:AppBarButton
              x:Name="ButtonSave"
              Label="{x:Static res:Resources.SaveYmmpLabel}"
              Icon="Save"
              Command="{Binding SaveYmmp}"
            />

            <ui:AppBarElementContainer
              VerticalAlignment="Center"
            >
              <ui:SimpleStackPanel>
                  <ui:ToggleSwitch
                      x:Name="toggleSwitch"
                      OffContent="{x:Static res:Resources.OverwriteLabel}"
                      OnContent="{x:Static res:Resources.BackupSaveLabel}"
                      FontSize="11"
                      Margin="5,0"
                      VerticalAlignment="Center"
                      IsOn="{Binding IsSaveBackup}" />
                  <ui:ToggleSwitch
                      x:Name="toggleOpenWithSave"
                      OffContent="{x:Static res:Resources.OpenWithSaveLabel}"
                      OnContent="{x:Static res:Resources.OpenWithSaveLabel}"
                      FontSize="11"
                      Margin="5,0"
                      VerticalAlignment="Center"
                      IsOn="{Binding IsOpenWithSave}" />
              </ui:SimpleStackPanel>

            </ui:AppBarElementContainer>

          </ui:CommandBar>
          <TextBox x:Name="targetYmmpFileName"
              ui:ControlHelper.PlaceholderText="{x:Static res:Resources.YmmpPlaceholder}"
              Text="{Binding TargetYmmpFileName}"
              Width="Auto"

              FontSize="12"
              Margin="5"
              IsReadOnly="True"
          />
          <ui:SimpleStackPanel Orientation="Horizontal">
            <!-- キャラ口パク設定 -->
            <GroupBox>
              <GroupBox.Header>
                <ui:SimpleStackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="ContactInfo" Margin="5" />
                  <TextBlock Text="{x:Static res:Resources.CharaLipSyncSettingsHeader}" FontSize="20" />
                </ui:SimpleStackPanel>
              </GroupBox.Header>

              <ui:SimpleStackPanel Orientation="Horizontal">
                <ui:SimpleStackPanel>

                  <ListView x:Name="Character"
                    MinHeight="100"
                    Width="200"
                    BorderBrush="{DynamicResource SystemBaseMediumLowColorBrush}"
                    Background="{DynamicResource SystemChromeLowColorBrush}"
                    ItemsSource="{Binding Characters}"
                    SelectedItem="{Binding SelectedCharaItem, Mode=OneWay}"
                  >
                    <ListView.ItemTemplate>
                      <DataTemplate>
                        <Button
                          Command="{Binding DataContext.ItemClick, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="0"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch">
                          <StackPanel Orientation="Horizontal">
                            <ToggleButton
                              ToolTip="{x:Static res:Resources.ExportToggleToolTip}"
                              Width="20"
                              Height="20"
                              Margin="0"
                              Padding="0"
                              IsChecked="{Binding IsExport}">
                              <TextBlock
                                Text="✔"
                                Margin="0"
                                Padding="0"
                                FontSize="8"
                                Visibility="{Binding IsExport, Converter={StaticResource BoolToVisible}}"
                                />
                            </ToggleButton>
                            <TextBlock
                              Margin="10,5,5,5"
                              FontWeight="Bold"
                              VerticalAlignment="Center"
                              IsEnabled="{Binding IsExport}"
                              Text="{Binding Name}"/>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>

                  <Separator />
                  <ui:SimpleStackPanel Orientation="Horizontal">
                    <ComboBox x:Name="LipSyncSetting"
                      SelectedIndex="0" Margin="5"
                      IsEnabled="False">
                      <ComboBoxItem Content="{x:Static res:Resources.LipSyncSetting1}" />
                      <ComboBoxItem Content="{x:Static res:Resources.LipSyncSetting2}" />
                    </ComboBox>
                    <ui:CommandBar DefaultLabelPosition="Right">
                      <ui:AppBarButton
                        Label="{x:Static res:Resources.AddButtonLabel}"
                        Icon="Add"
                        IsEnabled="False"
                      />
                    </ui:CommandBar>
                  </ui:SimpleStackPanel>
                </ui:SimpleStackPanel>
              </ui:SimpleStackPanel>
            </GroupBox>
            <!-- 口パク画像設定 -->
            <GroupBox
              IsEnabled="{Binding SelectedItem.IsExport, ElementName=Character}"
              >
              <GroupBox.Header>
                <ui:SimpleStackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="Setting"
                    Margin="2" />
                  <TextBlock
                    Text="{Binding SelectedItem.Name, ElementName=Character}"
                    FontSize="20" />
                  <Separator
                    Width="20"/>
                  <TextBlock
                    Text="{Binding SelectedItem.Content, ElementName=LipSyncSetting}"
                    FontSize="20" />
                </ui:SimpleStackPanel>
              </GroupBox.Header>

              <ui:SimpleStackPanel
                Margin="10,0,0,0"
                >
                <ui:SimpleStackPanel Orientation="Horizontal"
                  IsEnabled="False"
                  >
                  <Label Content="{x:Static res:Resources.LipSyncRuleLabel}" Margin="5" />
                  <ComboBox x:Name="LipSyncRule"
                    SelectedIndex="0"
                    Width="Auto"
                  >
                    <ListBoxItem Content="{x:Static res:Resources.StandardRule}" ToolTip="{x:Static res:Resources.StandardRuleToolTip}" />
                    <ListBoxItem Content="{x:Static res:Resources.LipSyncRule2}" />
                  </ComboBox>
                </ui:SimpleStackPanel>



                <ListView x:Name="LipSyncImage"
                  MinHeight="100"
                  Width="300"
                  BorderThickness="1"
                  BorderBrush="{DynamicResource SystemBaseMediumLowColorBrush}"
                  Background="{DynamicResource SystemChromeLowColorBrush}"
                  ItemsSource="{Binding LipSyncImages}"
                >
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock
                          Margin="5"
                          MinWidth="50"
                          Text="{Binding Name}"/>
                        <ComboBox
                          MinWidth="200"
                          MaxWidth="300"
                          Margin="0"
                          ItemsSource="{Binding ImageList}"
                          SelectedIndex="{Binding SelectedItemIndex}"
                          >
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <StackPanel Orientation="Horizontal">
                                <TextBlock
                                  Text="{Binding ImageName}"
                                  FontSize="10"
                                  Width="70"
                                  />
                                <Image
                                  Source="{Binding ImageSrc}"
                                  Width="100"
                                  Height="25"
                                  />
                              </StackPanel>
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>



                <ui:SimpleStackPanel
                  Orientation="Horizontal">
                  <Label Content="{x:Static res:Resources.OptionsHeader}" Margin="5" />
                  <ComboBox
                      ItemsSource="{Binding ConsonantOptionList}"
                      SelectedItem="{Binding CurrentConsonantOption}" DisplayMemberPath="Name" />
                </ui:SimpleStackPanel>
              </ui:SimpleStackPanel>
            </GroupBox>
          </ui:SimpleStackPanel>

          <!--
          <GroupBox Header="挿入レイヤー設定" Visibility="Collapsed">
            <ui:SimpleStackPanel></ui:SimpleStackPanel>
          </GroupBox>
          -->
          <GroupBox Header="{x:Static res:Resources.OptionsHeader}">
            <ui:SimpleStackPanel>
              <ui:SimpleStackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                >
                <CheckBox
                  x:Name="MyCheckBox"
                  Content="{x:Static res:Resources.EnableVisualLeadLabel}"
                  IsChecked="{Binding IsEnabledVisualLead, Mode=TwoWay}"
                  Margin="3" />
                <ui:NumberBox Header="{x:Static res:Resources.VisualLeadHeader}"
                  Value="{Binding VisualLeadMs}"
                  Minimum="0"
                  Maximum="200"
                  IsEnabled="{Binding ElementName=MyCheckBox, Path=IsChecked}"
                  />
              </ui:SimpleStackPanel>
              <Expander x:Name="otherOptions"
                        Header="{x:Static res:Resources.OthersHeader}"
                        ExpandDirection="Down"
                        IsExpanded="False"
                        VerticalAlignment="Top"
                        Margin="10,0,0,0">
                <WrapPanel fw:PointerTracker.Enabled="True">
                  <Button x:Name="openLicense"
                          Content="{x:Static res:Resources.LicenseButtonLabel}"
                          Margin="10"
                          Padding="5"
                          Style="{StaticResource ButtonRevealStyle}"
                          Command="{Binding OpenLicenses}" />
                  <Button x:Name="openWebsite"
                          Content="{x:Static res:Resources.KuchiPakuWebsiteLabel}"
                          Margin="10"
                          Padding="5"
                          Style="{StaticResource ButtonRevealStyle}"
                          Command="{Binding OpenWebsite}" />
                  <Button x:Name="openYMM4Website"
                          Content="{x:Static res:Resources.YMM4WebsiteLabel}"
                          Margin="10"
                          Padding="5"
                          Style="{StaticResource ButtonRevealStyle}"
                          Command="{Binding OpenYMM4Website}" />
                </WrapPanel>
              </Expander>
            </ui:SimpleStackPanel>
          </GroupBox>
        </ui:SimpleStackPanel>
      </ScrollViewer>



    </ui:NavigationView>

  </Grid>


